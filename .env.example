# FES Workspace (project Supabase chung, dữ liệu trong schema "contract"). Không bao giờ đặt service-role key ở đây.
VITE_SUPABASE_URL=https://<workspace-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key của project fes-workspace>
# Cookie phiên dùng chung sb-fes-auth. Production: .fptsx.space; staging: .staging.fptsx.space;
# để trống khi chạy local (cookie host-only).
VITE_WORKSPACE_COOKIE_DOMAIN=.fptsx.space
VITE_HUB_URL=https://hub.fptsx.space
